{
  "schema": "myriad.three_head_ownership.v1",
  "project": "MYRIAD OMEGA PENTARCH standalone",
  "source_branch": "agent/myriad-omega-independent-handoff",
  "branches": {
    "HEAD_A": "agent/myriad-head-a-coordination",
    "HEAD_B": "agent/myriad-head-b-training",
    "HEAD_C": "agent/myriad-head-c-runtime"
  },
  "rules": {
    "HEAD_A": [
      "coordination/**",
      "docs/**",
      ".github/**",
      "README.md",
      "README_NEXT_CHAT.md",
      "VERIFICATION.md",
      "INTEGRATION_PLAN.md",
      "DEPLOYMENT.md",
      "BUILD_STATUS_v1.md",
      "SOURCE_MANIFEST.json",
      "index.html",
      "assets/**",
      "workflows.json",
      "hyper_registry.py",
      "operations.py",
      "operations_extended.py",
      "integration_guard.py",
      "integration_contract.py",
      "tools/**",
      "verify_ui.py",
      "certify_fleet.py",
      "RELEASE_MANIFEST.json",
      "tests/test_source_snapshot.py",
      "tests/test_packaging.py",
      "tests/test_integration_guard.py",
      "tests/test_extended_workflows.py",
      "tests/test_ownership_contract.py"
    ],
    "HEAD_B": [
      "training/**",
      "mastery.py",
      "assessment.py",
      "tests/test_training*.py",
      "tests/test_fleet_training.py",
      "tests/test_independent_eval.py",
      "tests/test_policy_inference.py",
      "tests/test_robustness_gauntlet.py",
      "tests/test_adaptive*.py",
      "tests/test_transfer*.py",
      "tests/test_portable_policy_demo.py"
    ],
    "HEAD_C": [
      "fabric.py",
      "server.py",
      "agent_mesh.py",
      "evidence_vault.py",
      "http_security.py",
      "provider_budget.py",
      "mission_graph.py",
      "pipeline_runtime.py",
      "agent_profiles.py",
      "Dockerfile",
      "compose.yaml",
      ".dockerignore",
      "bootstrap_*.py",
      "bootstrap_*.ps1",
      "bootstrap_*.sh",
      "deploy_*.ps1",
      "run_*.sh",
      "run_*.bat",
      "tests/test_fabric.py",
      "tests/test_actor_mesh.py",
      "tests/test_http*.py",
      "tests/test_v13_hardening.py",
      "tests/test_v14_gateway_recovery.py",
      "tests/test_provider_budget.py",
      "tests/test_evidence_vault.py",
      "tests/test_pipeline_runtime.py",
      "tests/test_fleet_telemetry.py",
      "tests/test_v15_runtime.py"
    ]
  },
  "shared_change_rule": "Never commit a path assigned to another head; ask owning head via GitHub issue and publish a proposed patch in issue comment. Head A integrates reviewed commits only after base SHA and test verification.",
  "external_targets": [
    "reppiks490/umbra-sovereign-worlds",
    "reppiks490/Icarus"
  ],
  "external_mutations_allowed_before_13_of_13_gates": false,
  "codex_in_scheduled_automation": false
}